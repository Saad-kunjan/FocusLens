{
  "manifest_version": 3,
  "name": "FocusLens Tracker",
  "version": "1.0.0",
  "description": "Tracks how much time you spend on each website and sends it to your FocusLens dashboard.",
  "permissions": ["tabs", "idle", "alarms", "storage"],
  "host_permissions": ["http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FocusLens",
    "default_popup": "popup.html"
  }
}
